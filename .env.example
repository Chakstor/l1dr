# LLM providers (rellena al menos la del proveedor que uses)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# openai | anthropic
LLM_PROVIDER=openai
# gpt-4o-mini (openai) | claude-haiku-4-5 (anthropic)
LLM_MODEL=gpt-4o-mini

# development | staging | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG

# --- Sesión 3: wrapper LiteLLM (primario + fallback) ---
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=claude-haiku-4-5-20251001
# segundos de espera por llamada y número de reintentos
LLM_TIMEOUT=30
LLM_RETRIES=2

# --- Sesión 3: caché Redis ---
# Redis corre en Docker y la API en tu máquina, por eso localhost
REDIS_URL=redis://localhost:6379
# segundos que dura una respuesta en caché (86400 = 24h)
CACHE_TTL=86400