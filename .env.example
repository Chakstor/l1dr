# LLM providers (rellena al menos la del proveedor que uses)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# openai | anthropic
LLM_PROVIDER=openai
# gpt-4o-mini (openai) | claude-haiku-4-5 (anthropic)
LLM_MODEL=gpt-4o-mini

# development | staging | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG